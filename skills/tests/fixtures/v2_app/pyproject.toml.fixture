[project]
name = "sample-app"
version = "0.1.0"
requires-python = ">=3.8"
dependencies = [
    "permit>=2.8,<3",
    "pydantic[email]>=1.10,<2",
    "aiohttp==3.12.14",
]

[tool.mypy]
python_version = "3.9"

[[tool.mypy.overrides]]
module = ["permit", "permit.*"]
ignore_missing_imports = true

[tool.pytest.ini_options]
filterwarnings = ["error"]
